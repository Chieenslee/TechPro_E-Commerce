@model TechPro.Models.DTOs.ProductListDto
@{
    var image = string.IsNullOrWhiteSpace(Model.PrimaryImage) ? "/images/placeholder.webp" : Model.PrimaryImage;
}

<article class="product-card">
    <a href="/products/@Model.Slug" class="product-card__image">
        <img src="@image" alt="@Model.Name" loading="lazy">
        <div class="product-card__badges">
            @if (Model.IsNew)
            {
                <span class="badge badge-new">NEW</span>
            }
            @if (Model.IsBestSeller)
            {
                <span class="badge badge-hot">HOT</span>
            }
            @if (Model.DiscountPercent.HasValue && Model.DiscountPercent.Value > 0)
            {
                <span class="badge badge-sale">-@Model.DiscountPercent.Value.ToString("0")%</span>
            }
        </div>
    </a>
    <button class="product-card__wish" type="button" onclick="TechPro.toggleWishlist(this, @Model.Id)" aria-label="Yêu thích">
        <i class="bi bi-heart"></i>
    </button>
    <div class="product-card__body">
        <div class="product-card__brand">@Model.BrandName</div>
        <a href="/products/@Model.Slug" class="product-card__name">@Model.Name</a>
        <div class="product-card__rating">
            <span class="stars">
                @for (var i = 1; i <= 5; i++)
                {
                    <i class="bi bi-star@(Model.AverageRating >= i ? "-fill" : "")"></i>
                }
            </span>
            <span class="rating-count">(@Model.ReviewCount)</span>
        </div>
        <div class="product-card__price">
            <span class="price-current">@Model.Price.ToString("N0") đ</span>
            @if (Model.ComparePrice.HasValue && Model.ComparePrice.Value > Model.Price)
            {
                <span class="price-old">@Model.ComparePrice.Value.ToString("N0") đ</span>
            }
        </div>
        <div class="product-card__footer">
            <button class="btn-cart" type="button" onclick="TechPro.addToCart(@Model.Id)">Thêm giỏ</button>
            <a class="btn-view" href="/products/@Model.Slug" aria-label="Xem chi tiết"><i class="bi bi-eye"></i></a>
        </div>
    </div>
</article>
