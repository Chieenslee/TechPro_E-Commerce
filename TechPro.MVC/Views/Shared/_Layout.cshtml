@{
    var cartCount = ViewBag.CartCount ?? 0;
    var currentUser = ViewBag.CurrentUser as string;
}
<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@(ViewBag.MetaDescription ?? "TechPro - Thiết bị điện tử chính hãng, giá tốt nhất")">
    <title>@(ViewBag.Title != null ? ViewBag.Title + " | TechPro" : "TechPro – Công Nghệ Đỉnh Cao")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/techpro.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="top-deal-strip">
        <span>Freeship đơn từ 500K</span>
        <span>Trả góp 0%</span>
        <span>Thu cũ đổi mới</span>
    </div>
    <!-- Navbar -->
    <nav class="tp-navbar" id="mainNavbar">
        <div class="tp-navbar__inner">
            <!-- Logo -->
            <a href="/" class="tp-navbar__logo">
                <span class="logo-icon"><i class="bi bi-cpu-fill"></i></span>
                <span class="logo-text">Tech<span class="logo-accent">Pro</span></span>
            </a>

            <!-- Search Bar -->
            <div class="tp-navbar__search" id="searchBar">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="navSearch" placeholder="Tìm điện thoại, laptop, tai nghe..." autocomplete="off">
                <div class="search-suggestions" id="searchSuggestions"></div>
            </div>

            <!-- Actions -->
            <div class="tp-navbar__actions">
                <a href="/Wishlist" class="action-btn" title="Yêu thích">
                    <i class="bi bi-heart"></i>
                </a>
                <a href="/Cart" class="action-btn cart-btn" title="Giỏ hàng">
                    <i class="bi bi-bag"></i>
                    <span class="cart-badge" id="cartBadge">@cartCount</span>
                </a>
                @if (currentUser != null)
                {
                    <div class="user-menu">
                        <button class="action-btn user-btn">
                            <i class="bi bi-person-circle"></i>
                        </button>
                        <div class="user-dropdown">
                            <a href="/Account/Profile"><i class="bi bi-person"></i> Tài khoản</a>
                            <a href="/Orders"><i class="bi bi-box-seam"></i> Đơn hàng</a>
                            <a href="/Account/Points"><i class="bi bi-star"></i> Điểm thưởng</a>
                            <hr>
                            <a href="/Account/Logout"><i class="bi bi-box-arrow-right"></i> Đăng xuất</a>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/Account/Login" class="btn-login">Đăng nhập</a>
                }
                <button class="mobile-menu-btn" id="mobileMenuBtn"><i class="bi bi-list"></i></button>
            </div>
        </div>

        <!-- Category Nav -->
        <div class="tp-navbar__cats">
            <div class="cats-inner">
                <a href="/products?categorySlug=dien-thoai"><i class="bi bi-phone"></i> Điện Thoại</a>
                <a href="/products?categorySlug=laptop"><i class="bi bi-laptop"></i> Laptop</a>
                <a href="/products?categorySlug=tablet"><i class="bi bi-tablet"></i> Tablet</a>
                <a href="/products?categorySlug=tai-nghe"><i class="bi bi-headphones"></i> Tai Nghe</a>
                <a href="/products?categorySlug=dong-ho-thong-minh"><i class="bi bi-smartwatch"></i> Đồng Hồ</a>
                <a href="/products?categorySlug=phu-kien"><i class="bi bi-bag"></i> Phụ Kiện</a>
                <a href="/flash-sale" class="flash-link"><i class="bi bi-lightning-charge-fill"></i> Flash Sale</a>
            </div>
        </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <!-- Main Content -->
    <main class="tp-main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="tp-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <div class="footer-logo">
                    <i class="bi bi-cpu-fill"></i> Tech<span>Pro</span>
                </div>
                <p>Thiết bị điện tử chính hãng.<br>Công nghệ đỉnh cao – Giá tốt nhất.</p>
                <div class="footer-social">
                    <a href="#"><i class="bi bi-facebook"></i></a>
                    <a href="#"><i class="bi bi-instagram"></i></a>
                    <a href="#"><i class="bi bi-youtube"></i></a>
                    <a href="#"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>
            <div class="footer-links">
                <h4>Sản phẩm</h4>
                <a href="/products?categorySlug=dien-thoai">Điện thoại</a>
                <a href="/products?categorySlug=laptop">Laptop</a>
                <a href="/products?categorySlug=tablet">Tablet</a>
                <a href="/products?categorySlug=tai-nghe">Tai nghe</a>
                <a href="/flash-sale">Flash Sale</a>
            </div>
            <div class="footer-links">
                <h4>Hỗ trợ</h4>
                <a href="/orders">Tra cứu đơn hàng</a>
                <a href="/returns">Đổi trả hàng</a>
                <a href="/warranty">Bảo hành</a>
                <a href="/contact">Liên hệ</a>
            </div>
            <div class="footer-contact">
                <h4>Liên hệ</h4>
                <p><i class="bi bi-geo-alt"></i> 123 Nguyễn Huệ, Q.1, TP.HCM</p>
                <p><i class="bi bi-telephone"></i> 1900 6868</p>
                <p><i class="bi bi-envelope"></i> support@techpro.vn</p>
                <p><i class="bi bi-clock"></i> 8:00 - 22:00 mỗi ngày</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© 2026 TechPro. Bảo lưu mọi quyền.</p>
            <div class="payment-logos">
                <span>VNPAY</span><span>MOMO</span><span>ZALOPAY</span><span>COD</span>
            </div>
        </div>
    </footer>

    <!-- Chatbot FAB -->
    <button class="chatbot-fab" id="chatbotFab" title="Tư vấn AI">
        <i class="bi bi-robot"></i>
    </button>

    <script src="~/js/techpro.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
