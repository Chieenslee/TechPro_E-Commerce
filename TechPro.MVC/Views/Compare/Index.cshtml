        <p>Bấm “So sánh” trên card sản phẩm để thêm vào danh sách.</p>
        <a class="btn-primary" href="/products">Xem sản phẩm</a>
    </div>
</section>

@section Scripts {
    <script>window.TechPro?.renderComparePage();</script>
}
