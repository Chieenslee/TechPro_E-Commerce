@model TechPro.Models.DTOs.CartDto
@{
    var shipping = Model.SubTotal >= 500000 || !Model.Items.Any() ? 0 : 30000;
    var total = Model.SubTotal + shipping;
}

<section class="store-page">
    <div class="store-heading">
        <div>
            <p class="store-kicker">Shopping Cart</p>
            <h1>Giỏ hàng</h1>
            <span>@Model.TotalItems sản phẩm</span>
        </div>
        <a class="btn-outline" href="/products">Tiếp tục mua</a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="empty-state">
            <i class="bi bi-bag"></i>
            <h2>Giỏ hàng đang trống</h2>
            <p>Chọn sản phẩm yêu thích và quay lại đây để thanh toán.</p>
            <a class="btn-primary" href="/products">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var item in Model.Items)
                {
                    <article class="cart-item">
                        <a href="/products/@item.ProductSlug"><img src="@(item.ProductImage ?? "/images/placeholder.webp")" alt="@item.ProductName"></a>
                        <div>
                            <a class="cart-name" href="/products/@item.ProductSlug">@item.ProductName</a>
                            @if (!string.IsNullOrWhiteSpace(item.VariantInfo))
                            {
                                <span>@item.VariantInfo</span>
                            }
                            <strong>@item.UnitPrice.ToString("N0") đ</strong>
                        </div>
                        <form method="post" action="/cart/items/@item.Id">
                            @Html.AntiForgeryToken()
                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@Math.Max(item.MaxStock, 1)">
                            <button type="submit">Cập nhật</button>
                        </form>
                        <form method="post" action="/cart/items/@item.Id/remove">
                            @Html.AntiForgeryToken()
                            <button class="icon-danger" type="submit" aria-label="Xóa"><i class="bi bi-trash"></i></button>
                        </form>
                    </article>
                }
            </div>
            <aside class="order-summary">
                <h2>Tóm tắt đơn hàng</h2>
                <div class="voucher-box">
                    <label for="voucherCode">Mã giảm giá</label>
                    <div>
                        <input id="voucherCode" placeholder="TECHPRO5">
                        <button type="button" onclick="TechPro.applyVoucher()">Áp dụng</button>
                    </div>
                    <small>Gợi ý: TECHPRO5 giảm 5%, FREESHIP miễn phí giao hàng.</small>
                </div>
                <div><span>Tạm tính</span><b>@Model.SubTotal.ToString("N0") đ</b></div>
                <div><span>Phí giao hàng</span><b id="shippingAmount" data-value="@shipping">@shipping.ToString("N0") đ</b></div>
                <div><span>Giảm giá</span><b id="discountAmount">0 đ</b></div>
                <div class="summary-total"><span>Tổng cộng</span><b id="cartTotal" data-subtotal="@Model.SubTotal" data-shipping="@shipping">@total.ToString("N0") đ</b></div>
                <a class="btn-primary" href="/checkout">Thanh toán</a>
            </aside>
        </div>
    }
</section>
