<section class="store-page">
    <div class="store-heading">
        <div>
            <p class="store-kicker">Wishlist</p>
            <h1>Sản phẩm yêu thích</h1>
            <span id="wishlistCountText">Các sản phẩm bạn đã lưu trên trình duyệt này</span>
        </div>
        <a class="btn-outline" href="/products">Tiếp tục mua</a>
    </div>

    <div class="product-grid" id="wishlistGrid"></div>
    <div class="empty-state" id="wishlistEmpty" hidden>
        <i class="bi bi-heart"></i>
        <h2>Chưa có sản phẩm yêu thích</h2>
        <p>Bấm biểu tượng trái tim trên sản phẩm để lưu lại.</p>
        <a class="btn-primary" href="/products">Xem sản phẩm</a>
    </div>
</section>

@section Scripts {
    <script>window.TechPro?.renderWishlistPage();</script>
}
