@model List<TechPro.Models.DTOs.FlashSaleDto>

<section class="store-page">
    <div class="store-heading">
        <div>
            <p class="store-kicker">Flash Sale</p>
            <h1>Ưu đãi đang diễn ra</h1>
            <span>@Model.Count sản phẩm giảm giá</span>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="product-grid">
            @foreach (var sale in Model)
            {
                var product = sale.Product;
                product.Price = sale.SalePrice;
                product.ComparePrice = sale.OriginalPrice;
                <partial name="_ProductCard" model="product" />
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-lightning-charge"></i>
            <h2>Chưa có flash sale</h2>
            <p>Quay lại sau hoặc xem các sản phẩm đang bán tại TechPro.</p>
            <a class="btn-primary" href="/products">Xem sản phẩm</a>
        </div>
    }
</section>
