@model TechPro.Models.ViewModels.ProductCatalogViewModel
@{
    ViewBag.Title = "Sản phẩm";
}

<section class="store-page">
    <div class="store-heading">
        <div>
            <p class="store-kicker">TechPro Catalog</p>
            <h1>Sản phẩm điện tử</h1>
            <span>@Model.Products.TotalCount sản phẩm phù hợp</span>
        </div>
        <form class="store-sort" method="get">
            <input type="hidden" name="search" value="@Model.Query.Search">
            <input type="hidden" name="categorySlug" value="@Model.Query.CategorySlug">
            <input type="hidden" name="brandSlug" value="@Model.Query.BrandSlug">
            <select name="sortBy" onchange="this.form.submit()">
                <option value="newest" selected="@(Model.Query.SortBy == "newest")">Mới nhất</option>
                <option value="sold" selected="@(Model.Query.SortBy == "sold")">Bán chạy</option>
                <option value="price_asc" selected="@(Model.Query.SortBy == "price_asc")">Giá tăng dần</option>
                <option value="price_desc" selected="@(Model.Query.SortBy == "price_desc")">Giá giảm dần</option>
                <option value="rating" selected="@(Model.Query.SortBy == "rating")">Đánh giá cao</option>
            </select>
        </form>
    </div>

    <div class="catalog-layout">
        <aside class="catalog-filter">
            <form method="get">
                <label>Tìm kiếm</label>
                <input name="search" value="@Model.Query.Search" placeholder="iPhone, laptop, tai nghe...">

                <label>Danh mục</label>
                <select name="categorySlug">
                    <option value="">Tất cả danh mục</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Slug" selected="@(Model.Query.CategorySlug == category.Slug)">@category.Name</option>
                    }
                </select>

                <label>Thương hiệu</label>
                <select name="brandSlug">
                    <option value="">Tất cả thương hiệu</option>
                    @foreach (var brand in Model.Brands)
                    {
                        <option value="@brand.Slug" selected="@(Model.Query.BrandSlug == brand.Slug)">@brand.Name</option>
                    }
                </select>

                <div class="filter-grid">
                    <div>
                        <label>Giá từ</label>
                        <input name="minPrice" value="@Model.Query.MinPrice" inputmode="numeric">
                    </div>
                    <div>
                        <label>Đến</label>
                        <input name="maxPrice" value="@Model.Query.MaxPrice" inputmode="numeric">
                    </div>
                </div>

                <label class="check-line">
                    <input type="checkbox" name="inStock" value="true" checked="@(Model.Query.InStock == true)">
                    Còn hàng
                </label>
                <input type="hidden" name="sortBy" value="@Model.Query.SortBy">
                <button class="btn-primary" type="submit">Lọc sản phẩm</button>
            </form>
        </aside>

        <div>
            @if (Model.Products.Items.Any())
            {
                <div class="product-grid">
                    @foreach (var product in Model.Products.Items)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>

                @if (Model.Products.TotalPages > 1)
                {
                    <div class="pager">
                        @if (Model.Products.HasPrevious)
                        {
                            <a href="@PageUrl(Model.Products.Page - 1)">Trước</a>
                        }
                        <span>Trang @Model.Products.Page / @Model.Products.TotalPages</span>
                        @if (Model.Products.HasNext)
                        {
                            <a href="@PageUrl(Model.Products.Page + 1)">Sau</a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-search"></i>
                    <h2>Không tìm thấy sản phẩm</h2>
                    <p>Thử đổi bộ lọc hoặc tìm theo từ khóa khác.</p>
                    <a class="btn-primary" href="/products">Xóa bộ lọc</a>
                </div>
            }
        </div>
    </div>
</section>

@functions {
    private string PageUrl(int page)
    {
        var query = new Dictionary<string, string?>
        {
            ["search"] = Model.Query.Search,
            ["categorySlug"] = Model.Query.CategorySlug,
            ["brandSlug"] = Model.Query.BrandSlug,
            ["sortBy"] = Model.Query.SortBy,
            ["page"] = page.ToString()
        };
        return "/products?" + string.Join("&", query.Where(x => !string.IsNullOrWhiteSpace(x.Value)).Select(x => $"{x.Key}={Uri.EscapeDataString(x.Value!)}"));
    }
}
