@model TechPro.Models.ViewModels.StoreHomeViewModel
@{
    ViewBag.Title = "Thiết bị điện tử chính hãng";
}

<section class="hero">
    <div class="hero-grid">
        <div>
            <div class="hero-badge"><i class="bi bi-lightning-charge-fill"></i> Công nghệ mới, giá tốt mỗi ngày</div>
            <h1>Thiết bị điện tử <span>chính hãng</span> cho mọi nhu cầu</h1>
            <p class="hero-desc">Mua điện thoại, laptop, tablet, tai nghe và phụ kiện tại TechPro với ưu đãi rõ ràng, bảo hành minh bạch và giao hàng nhanh.</p>
            <div class="hero-cta">
                <a href="/products" class="btn-primary">Mua ngay</a>
                <a href="/flash-sale" class="btn-outline">Xem Flash Sale</a>
            </div>
            <div class="hero-stats">
                <div class="stat-item"><span class="stat-num">100%</span><span class="stat-label">Chính hãng</span></div>
                <div class="stat-item"><span class="stat-num">24h</span><span class="stat-label">Giao nhanh</span></div>
                <div class="stat-item"><span class="stat-num">12+</span><span class="stat-label">Tháng bảo hành</span></div>
            </div>
        </div>
        <div class="hero-visual">
            <div class="orbit orbit-1"><span class="orbit-dot"></span></div>
            <div class="orbit orbit-2"><span class="orbit-dot"></span></div>
            <div class="hero-phone">
                <i class="bi bi-phone phone-screen"></i>
                <span class="phone-label">TECHPRO STORE</span>
            </div>
        </div>
    </div>
</section>

@if (Model.Categories.Any())
{
    <section class="section">
        <div class="section-header">
            <h2 class="section-title">Danh mục <span>nổi bật</span></h2>
            <a class="section-link" href="/products">Tất cả sản phẩm <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="cat-grid">
            @foreach (var category in Model.Categories.Take(8))
            {
                <a class="cat-card" href="/products?categorySlug=@category.Slug">
                    <i class="bi bi-@(string.IsNullOrWhiteSpace(category.Icon) ? "cpu" : category.Icon)"></i>
                    <h3>@category.Name</h3>
                    <span>@category.ProductCount sản phẩm</span>
                </a>
            }
        </div>
    </section>
}

@if (Model.FlashSales.Any())
{
    var firstSale = Model.FlashSales.First();
    <section class="flash-sale-section">
        <div class="flash-header">
            <div class="flash-title"><i class="bi bi-lightning-charge-fill"></i> Flash Sale</div>
            <div class="countdown">
                <div class="countdown-block"><div class="countdown-num" data-cd="home-h">00</div><div class="countdown-label">Giờ</div></div>
                <div class="countdown-sep">:</div>
                <div class="countdown-block"><div class="countdown-num" data-cd="home-m">00</div><div class="countdown-label">Phút</div></div>
                <div class="countdown-sep">:</div>
                <div class="countdown-block"><div class="countdown-num" data-cd="home-s">00</div><div class="countdown-label">Giây</div></div>
            </div>
        </div>
        <div class="product-grid">
            @foreach (var sale in Model.FlashSales.Take(4))
            {
                var product = sale.Product;
                product.Price = sale.SalePrice;
                product.ComparePrice = sale.OriginalPrice;
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>
    @section Scripts {
        <script>window.TechPro?.startCountdown('@firstSale.EndTime.ToString("O")', 'home');</script>
    }
}

<section class="section">
    <div class="section-header">
        <h2 class="section-title">Sản phẩm <span>nổi bật</span></h2>
        <a class="section-link" href="/products?sortBy=sold">Xem thêm <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="product-grid">
        @foreach (var product in Model.FeaturedProducts)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</section>

<section class="section">
    <div class="section-header">
        <h2 class="section-title">Bán chạy <span>tuần này</span></h2>
        <a class="section-link" href="/products?sortBy=sold">Xem thêm <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="product-grid">
        @foreach (var product in Model.BestSellers)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</section>

<section class="section">
    <div class="section-header">
        <h2 class="section-title">Hàng <span>mới về</span></h2>
        <a class="section-link" href="/products?sortBy=newest">Xem thêm <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="product-grid">
        @foreach (var product in Model.NewArrivals)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
</section>

@if (Model.Brands.Any())
{
    <section class="section">
        <div class="section-header">
            <h2 class="section-title">Thương hiệu <span>phổ biến</span></h2>
        </div>
        <div class="brands-strip">
            @foreach (var brand in Model.Brands)
            {
                <a class="brand-chip" href="/products?brandSlug=@brand.Slug">
                    <i class="bi bi-award"></i> @brand.Name
                </a>
            }
        </div>
    </section>
}
